<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="raiz" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="uam.edu.ni.evaluacion_javafx_citastecnicas.controller.MenuPrincipalController">
    <left>
        <VBox prefWidth="210.0" style="-fx-background-color: #1e293b;">

            <!-- Branding -->
            <VBox spacing="4.0" style="-fx-background-color: #0f172a;">
                <padding>
                    <Insets bottom="20.0" left="16.0" right="16.0" top="24.0" />
                </padding>
                <Label style="-fx-text-fill: #f8fafc; -fx-font-size: 16px; -fx-font-weight: bold;" text="TecnoAsistencia" />
                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Nicaragua" />
            </VBox>

            <!-- Navegación -->
            <VBox spacing="4.0">
                <padding>
                    <Insets bottom="8.0" left="8.0" right="8.0" top="20.0" />
                </padding>
                <Label style="-fx-text-fill: #475569; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 0 4 8;" text="MÓDULOS" />
                <Button maxWidth="Infinity" onAction="#mostrarClientes" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 6;" text="Clientes" />
                <Button maxWidth="Infinity" onAction="#mostrarCitas" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 6;" text="Citas técnicas" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Footer -->
            <VBox spacing="6.0">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="8.0" />
                </padding>
                <Separator style="-fx-background-color: #334155; -fx-border-color: #334155;" />
                <Label style="-fx-text-fill: #475569; -fx-font-size: 11px;" text="v1.0.0  ·  2026" />
            </VBox>

        </VBox>
    </left>
</BorderPane>
