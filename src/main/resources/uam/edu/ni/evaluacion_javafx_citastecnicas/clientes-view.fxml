<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" style="-fx-background-color: #f1f5f9;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="uam.edu.ni.evaluacion_javafx_citastecnicas.controller.ClientesController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <!-- Encabezado de página -->
    <VBox spacing="2.0">
        <Label text="Gestión de Clientes"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        <Label text="Registrá, editá y eliminá los clientes del sistema."
               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
    </VBox>

    <Separator/>

    <!-- Formulario en tarjeta -->
    <VBox spacing="12.0"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
        <padding>
            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
        </padding>

        <Label text="Datos del cliente"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>

        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="90.0" prefWidth="95.0" maxWidth="110.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0"/>
                <ColumnConstraints minWidth="90.0" prefWidth="95.0" maxWidth="110.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0"/>
            </columnConstraints>

            <Label text="Nombres"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nombresField" promptText="Nombres del cliente"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Apellidos"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="apellidosField" promptText="Apellidos del cliente"
                       GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Teléfono"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="telefonoField" promptText="Ej: 8888-8888"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Correo"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="correoField" promptText="correo@ejemplo.com"
                       GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <CheckBox fx:id="activoCheckBox" text="Cliente activo"
                      GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <!-- Botones de acción con colores semánticos -->
        <HBox spacing="10.0">
            <Button text="Guardar" onAction="#guardarCliente"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
            <Button text="Actualizar" onAction="#actualizarCliente"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
            <Button text="Eliminar" onAction="#eliminarCliente"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
            <Button text="Limpiar formulario" onAction="#limpiarFormulario"
                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
        </HBox>
    </VBox>

    <!-- Barra de búsqueda -->
    <HBox spacing="10.0">
        <TextField fx:id="busquedaField"
                   promptText="Buscar por ID, nombre, teléfono o correo..."
                   HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#buscarClientes"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
        <Button text="Mostrar todos" onAction="#mostrarTodos"
                style="-fx-background-color: white; -fx-text-fill: #374151; -fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-padding: 7 14 7 14;"/>
    </HBox>

    <!-- Tabla de clientes -->
    <TableView fx:id="clientesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"        text="ID"        prefWidth="55.0"/>
            <TableColumn fx:id="nombresColumn"   text="Nombres"   prefWidth="140.0"/>
            <TableColumn fx:id="apellidosColumn" text="Apellidos" prefWidth="140.0"/>
            <TableColumn fx:id="telefonoColumn"  text="Teléfono"  prefWidth="110.0"/>
            <TableColumn fx:id="correoColumn"    text="Correo"    prefWidth="220.0"/>
            <TableColumn fx:id="activoColumn"    text="Activo"    prefWidth="70.0"/>
        </columns>
    </TableView>

</VBox>
