<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="uam.edu.ni.evaluacion_javafx_citastecnicas.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="welcomeText" text="TecnoAsistencia Nicaragua"/>
    <Button text="Abrir Módulo de Citas Técnicas" onAction="#abrirModuloCitas"
            style="-fx-background-color: #0288d1; -fx-text-fill: white; -fx-font-weight: bold;"/>
</VBox>
