<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0" style="-fx-background-color: #f1f5f9;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="uam.edu.ni.evaluacion_javafx_citastecnicas.controller.CitaController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <!-- Encabezado de página -->
    <VBox spacing="2.0">
        <Label text="Gestión de Citas Técnicas"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        <Label text="Registrá, editá, filtrá y gestioná las citas de atención técnica."
               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
    </VBox>

    <Separator/>

    <!-- Formulario en tarjeta blanca -->
    <VBox spacing="12.0"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
        <padding>
            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
        </padding>

        <Label text="Datos de la cita"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>

        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="90.0" prefWidth="95.0" maxWidth="110.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0"/>
                <ColumnConstraints minWidth="90.0" prefWidth="95.0" maxWidth="110.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="140.0"/>
            </columnConstraints>

            <!-- Fila 0: Cliente y Estado -->
            <Label text="Cliente:*"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbCliente" promptText="Seleccione un cliente" maxWidth="Infinity"
                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Estado:*"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbEstado" promptText="Seleccione estado" maxWidth="Infinity"
                      GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Fila 1: Fecha y Hora -->
            <Label text="Fecha:*"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpFecha" promptText="AAAA-MM-DD" maxWidth="Infinity"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Hora (HH:mm):*"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtHora" promptText="Ej: 09:00 o 14:30"
                       GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Fila 2: Servicio y Descripción -->
            <Label text="Servicio:*"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtTipoServicio" promptText="Ej: Mantenimiento, Reparación"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Descripción:*"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <TextField fx:id="txtDescripcion" promptText="Detalle del problema o servicio"
                       GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        </GridPane>

        <!-- Botones de acción del formulario -->
        <HBox spacing="10.0">
            <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarCita"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
            <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizarCita"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarCita"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
            <Button fx:id="btnLimpiar" text="Limpiar formulario" onAction="#limpiarFormulario"
                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
        </HBox>
    </VBox>

    <!-- Barra de filtros (RF06) y búsqueda -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Filtrar por estado:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <ComboBox fx:id="cmbFiltroEstado" prefWidth="140.0"/>

        <Label text="Fecha:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <DatePicker fx:id="dpFiltroFecha" prefWidth="140.0" promptText="Filtrar fecha"/>

        <Button fx:id="btnFiltrar" text="Filtrar" onAction="#aplicarFiltros"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16 8 16;"/>
        <Button fx:id="btnLimpiarFiltros" text="Mostrar todas" onAction="#limpiarFiltros"
                style="-fx-background-color: white; -fx-text-fill: #374151; -fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-padding: 7 14 7 14;"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotalRegistros" text="Total de citas: 0"
               style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
    </HBox>

    <!-- Tabla de Citas (RF04) -->
    <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="55.0"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180.0"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100.0"/>
            <TableColumn fx:id="colHora" text="Hora" prefWidth="85.0"/>
            <TableColumn fx:id="colServicio" text="Servicio" prefWidth="140.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="105.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
